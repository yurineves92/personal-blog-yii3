# Variáveis usadas pelo docker-compose (e pela aplicação fora do Docker).
# Copie para .env e ajuste se necessário.

APP_ENV=dev
APP_DEBUG=true

# Porta do Nginx no host: http://localhost:8080
APP_PORT=8080

DB_NAME=miniblog
DB_USER=miniblog
DB_PASSWORD=miniblog
DB_ROOT_PASSWORD=root
# Porta do MySQL exposta no host (para clientes como DBeaver/TablePlus)
DB_EXTERNAL_PORT=3307

# Usadas apenas quando a aplicação roda fora do Docker:
# DB_HOST=127.0.0.1
# DB_PORT=3307
