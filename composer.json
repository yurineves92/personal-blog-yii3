{
    "name": "app/miniblog",
    "type": "project",
    "description": "Miniblog com landing page, blog público e painel CMS construído com Yii3 + MySQL",
    "license": "BSD-3-Clause",
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve"
        ]
    },
    "require": {
        "php": "8.2 - 8.5",
        "ext-filter": "*",
        "ext-pdo": "*",
        "httpsoft/http-message": "^1.1.6",
        "league/commonmark": "^2.10",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "symfony/console": "^7.4.7 || ^8.0.7",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/auth": "^3.3",
        "yiisoft/cache": "^3.2",
        "yiisoft/cache-file": "^3.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/db-migration": "^2.1",
        "yiisoft/db-mysql": "^2.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/form-model": "^1.1",
        "yiisoft/html": "^4",
        "yiisoft/http": "^1.3",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.0",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/rbac": "^2.1",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/security": "^1.2",
        "yiisoft/session": "^3.0.1",
        "yiisoft/user": "^2.3",
        "yiisoft/validator": "^2.6",
        "yiisoft/view": "^12.2.4",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1",
        "zircote/swagger-php": "^6.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true,
            "composer/installers": true
        }
    }
}
